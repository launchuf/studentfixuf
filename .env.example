# Copy this file to .env for local development. Never commit .env to git.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
VITE_SUPABASE_PROJECT_ID=xxxxxxxx

# Server-only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# Public storefront origin used for Stripe return URLs
PUBLIC_SITE_URL=https://studentfixuf.se

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Optional: Stripe webhook secret (for production payment confirmation)
STRIPE_WEBHOOK_SECRET=whsec_...
