# Supabase project settings (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...            # "anon" / "publishable" key — safe for the browser
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
VITE_SUPABASE_PROJECT_ID=xxxxxxxx

# Server-only — NEVER expose to the browser / commit to git
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (server-only). Leave unset to run checkout in demo mode.
STRIPE_SECRET_KEY=sk_test_...
